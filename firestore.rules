rules_version = '2';

// Spark (free) plan: no Cloud Functions or Admin SDK, so every write comes
// from a client and these rules carry all of the validation.
//
// Design rules:
//  - Every write needs (anonymous) auth.
//  - Documents are written once, with a client idempotency key as the id.
//    A retry may re-write the *identical* document; nothing else updates.
//  - No client ever writes an aggregate (counts, averages). Aggregates are
//    computed by readers from the individual documents.
//  - No collection stores PII; locations are rounded to ~1 km tiles.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasOnlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function hasAllKeys(required) {
      return request.resource.data.keys().hasAll(required);
    }

    function isGeoTile(v) {
      return v is string && v.matches('^-?[0-9]{1,2}[.][0-9]{2},-?[0-9]{1,3}[.][0-9]{2}$');
    }

    // Client timestamps (ms) must be within a day of server time.
    function recentMillis(v) {
      return v is int
        && v > request.time.toMillis() - 86400000
        && v < request.time.toMillis() + 300000;
    }

    function identicalRetry() {
      return request.resource.data == resource.data;
    }

    // Anonymised soil classifications from a *validated* model.
    // Publicly readable so the community map can aggregate them.
    match /soilScans/{scanId} {
      function validScan() {
        let d = request.resource.data;
        return hasOnlyKeys(['geoTile', 'soilType', 'confidence', 'modelVersion', 'timestamp'])
          && hasAllKeys(['geoTile', 'soilType', 'confidence', 'modelVersion', 'timestamp'])
          && isGeoTile(d.geoTile)
          && d.soilType in ['alluvial', 'black', 'laterite', 'red']
          && d.confidence is number && d.confidence >= 0 && d.confidence <= 1
          && d.modelVersion is string && d.modelVersion.size() > 0 && d.modelVersion.size() <= 64
          && recentMillis(d.timestamp);
      }
      allow read: if true;
      allow create: if signedIn() && validScan();
      allow update: if signedIn() && identicalRetry();
      allow delete: if false;
    }

    match /fabricationRequests/{requestId} {
      function validRequest() {
        let d = request.resource.data;
        return hasOnlyKeys(['geoTile', 'shapeType', 'objectType', 'timestamp'])
          && hasAllKeys(['shapeType', 'timestamp'])
          && (!('geoTile' in d) || isGeoTile(d.geoTile))
          && d.shapeType in ['l_bracket', 'pipe_clamp', 'flat_stand', 'hinge_mount']
          && (!('objectType' in d) || d.objectType in ['pipe', 'rod', 'sheet'])
          && recentMillis(d.timestamp);
      }
      allow create: if signedIn() && validRequest();
      allow update: if signedIn() && identicalRetry();
      allow read, delete: if false;
    }

    match /growthUpdates/{updateId} {
      function validUpdate() {
        let d = request.resource.data;
        return hasOnlyKeys(['cropId', 'daysSincePlanting', 'status', 'timestamp'])
          && hasAllKeys(['cropId', 'daysSincePlanting', 'status', 'timestamp'])
          && d.cropId is string && d.cropId.size() <= 32
          && d.daysSincePlanting is int && d.daysSincePlanting >= 0 && d.daysSincePlanting <= 400
          && d.status in ['on_track', 'lagging']
          && recentMillis(d.timestamp);
      }
      allow create: if signedIn() && validUpdate();
      allow update: if signedIn() && identicalRetry();
      allow read, delete: if false;
    }

    // One rating per user per target. The document id is derived from the
    // target and the caller's uid, so a user can only ever hold one rating
    // per target and can only touch their own. Clients can only write
    // status 'visible'; moderators hide abusive reviews from the console
    // (status 'hidden'), and the author cannot un-hide a hidden rating.
    match /ratings/{ratingId} {
      function validRating() {
        let d = request.resource.data;
        return hasOnlyKeys(['targetType', 'targetId', 'uid', 'stars', 'review', 'status', 'createdAt', 'updatedAt'])
          && hasAllKeys(['targetType', 'targetId', 'uid', 'stars', 'review', 'status', 'createdAt', 'updatedAt'])
          && d.targetType == 'soilTile'
          && d.targetId is string && d.targetId.matches('^-?[0-9]{1,2}[.][0-9]{2}_-?[0-9]{1,3}[.][0-9]{2}$')
          && d.uid == request.auth.uid
          && ratingId == d.targetType + '_' + d.targetId + '_' + request.auth.uid
          && d.stars is int && d.stars >= 1 && d.stars <= 5
          && d.review is string && d.review.size() <= 500
          && d.status == 'visible'
          && d.createdAt is int
          && recentMillis(d.updatedAt);
      }
      allow read: if resource.data.status == 'visible'
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && validRating()
        && request.resource.data.createdAt == request.resource.data.updatedAt;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'visible'
        && validRating()
        && request.resource.data.createdAt == resource.data.createdAt
        // Throttle: at most one edit per 10 seconds per rating.
        && request.resource.data.updatedAt > resource.data.updatedAt + 10000;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Abuse reports: write-once, one per reporter per rating, never
    // readable by clients (moderators review them in the console).
    match /ratingReports/{reportId} {
      function validReport() {
        let d = request.resource.data;
        return hasOnlyKeys(['ratingId', 'reporterUid', 'reason', 'createdAt'])
          && hasAllKeys(['ratingId', 'reporterUid', 'reason', 'createdAt'])
          && d.ratingId is string && d.ratingId.size() <= 160
          && d.reporterUid == request.auth.uid
          && reportId == d.ratingId + '_' + request.auth.uid
          && d.reason in ['spam', 'abusive', 'wrong']
          && recentMillis(d.createdAt);
      }
      allow create: if signedIn() && validReport();
      allow read, update, delete: if false;
    }

    // Legacy client-written aggregate. Retired: clients could write any
    // count into it. Kept closed so old data cannot be read or forged.
    match /mapTiles/{tileId} {
      allow read, write: if false;
    }
  }
}
