# VIVA AI — environment template.
# Copy to `.env.local` (git-ignored) and fill in your own values.
# NEVER commit real keys. In CI, provide the same names as GitHub
# Actions repository secrets (Settings → Secrets and variables → Actions).
#
# Every VITE_* value is compiled into the client bundle and is visible in
# DevTools on the deployed site. Restrict each key by HTTP referrer /
# authorised domain in its provider console.
#
# Missing optional keys never crash the app: the affected feature shows a
# clearly labelled "unavailable" or "cached" state. Nothing falls back to
# invented data.

# --- Firebase (required for sign-in, ratings, cloud sync) ---------------
# Firebase Console → Project settings → Your apps → Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Weather (optional) -------------------------------------------------
# openweathermap.org free tier. SERVER-SIDE secret, read only by the dev/
# preview weather proxy (vite.config.ts) and, in production, the Cloudflare
# Worker (`wrangler secret put OPENWEATHER_API_KEY`). Never use a VITE_ name.
# Without it, weather shows "not set up" (or the last cached observation).
OPENWEATHER_API_KEY=

# --- Mandi prices (optional) --------------------------------------------
# The data.gov.in key is a SERVER-SIDE secret. It must never be a VITE_*
# variable: anything prefixed VITE_ is compiled into the public bundle, and
# GitHub Secrets do not change that.
#
# Local dev / preview: put the key here (in .env.local) as AGMARKNET_API_KEY.
# The Vite dev/preview server reads it and serves /api-mandi/prices itself;
# the browser never sees the key. `npm run build` fails if the key text ends
# up in any emitted file.
AGMARKNET_API_KEY=

# Production: deploy the Cloudflare Worker in server/mandi-worker (the key is
# stored there with `wrangler secret put AGMARKNET_API_KEY`) and set its URL
# here and as the GitHub Actions secret of the same name. Example:
# VITE_MANDI_PROXY_URL=https://viva-ai-mandi-proxy.<account>.workers.dev
# Without it, the production mandi screen shows "price service not
# configured" and never shows invented prices.
VITE_MANDI_PROXY_URL=

# --- Gemini AI (optional) -----------------------------------------------
# SERVER-SIDE secret, exactly like the mandi key: never VITE_GEMINI_API_KEY.
# Local dev / preview: the Vite server reads GEMINI_API_KEY and serves
# /api-ai/generate itself. `npm run build` fails if the key text appears in
# any emitted file. (A legacy VITE_GEMINI_API_KEY in .env.local is still read
# by the dev server only; client code never reads it.)
GEMINI_API_KEY=
# Optional: preferred model id; the proxy falls back to its built-in list.
GEMINI_MODEL=

# Production: the same Cloudflare Worker serves POST /ai/generate. Store the key with
#   npx wrangler@4 secret put GEMINI_API_KEY --config server/mandi-worker/wrangler.toml
# Nothing else is needed: the app calls ${VITE_MANDI_PROXY_URL}/ai/generate.
# Set VITE_AI_PROXY_URL (a Worker base URL, no path) only if the AI route
# runs on a different Worker. With neither set, AI features show
# "AI not configured" and the rest of the app works normally.
VITE_AI_PROXY_URL=
