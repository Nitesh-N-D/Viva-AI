# VIVA AI — environment template.
# Copy to `.env.local` (git-ignored) and fill in your own values.
# NEVER commit real keys. In CI, provide the same names as GitHub
# Actions repository secrets (Settings → Secrets and variables → Actions).
#
# Every VITE_* value is compiled into the client bundle and is visible in
# DevTools on the deployed site. Restrict each key by HTTP referrer /
# authorised domain in its provider console.
#
# Missing optional keys never crash the app: the affected feature shows a
# clearly labelled "unavailable" or "cached" state. Nothing falls back to
# invented data.

# --- Firebase (required for sign-in, ratings, cloud sync) ---------------
# Firebase Console → Project settings → Your apps → Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Weather (optional) -------------------------------------------------
# openweathermap.org free tier. Without it, weather shows "unavailable"
# (or the last cached observation, labelled with its age).
VITE_OPENWEATHER_API_KEY=

# --- Mandi prices (optional) --------------------------------------------
# data.gov.in → My Account → API key. Used for the Agmarknet resource
# 9ef84268-d588-465a-a308-a864a43d0070. data.gov.in sends
# `Access-Control-Allow-Origin: *` (verified 2026-11-01), so production
# calls it directly. The dev server proxies /api-mandi for convenience.
VITE_AGMARKNET_API_KEY=

# Optional: route mandi requests through your own proxy instead
# (e.g. if data.gov.in changes its CORS policy). Example:
# VITE_MANDI_PROXY_URL=https://your-domain.example/api-mandi
VITE_MANDI_PROXY_URL=
